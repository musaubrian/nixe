:b create @home/.ssh/
:b create @home/.local/bin/
:b create @home/.local/share/

:wp base_package {
  :ex sudo pacman -S --needed --noconfirm base-devel networkManager \
      ansible acpi bluez bluez-utils blueman pavucontrol \
      brightnessctl network-manager-applet fish mako git wget \
      gcc make sqlite unzip tree jq \
      tmux ffmpeg fzf yt-dlp hugo ripgrep \
      difftastic man-pages man-db less firefox syncthing \
      fuzzel feh zathura zathura-pdf-poppler telegram-desktop mpv \
      sshfs nodejs npm go php clang \
      llvm stylua lua-language-server tinymist ty svelte-language-server \
      marksman gopls tailwindcss-language-server noto-fonts noto-fonts-cjk noto-fonts-emoji \
      ttf-dejavu ttf-jetbrains-mono gnu-free-fonts waybar wl-clipboard cliphist \
      btop jujutsu kitty
}

:wp niri_packages {
  :ex sudo pacman -S --needed --noconfirm niri xwayland-satellite \
      xdg-desktop-portal-gnome xdg-desktop-portal-gtk swaybg swaylock
}

:wp keys {
  :ex ansible-vault decrypt ./keys/*
  :b copy ./keys/ ~/.ssh-copy/
  :ex ansible-vault encrypt ./keys/*
}

:wp yay {
  :ex git clone https://aur.archlinux.org/yay.git /tmp/yay/
  :ex pushd /tmp/yay/ && makepkg -si && popd
}

:wp services {
  :ex sudo systemctl enable NetworkManager
  :ex sudo systemctl enable sshd
  :ex sudo systemctl enable bluetooth.service
}

:wp stash {
  :b create @home/.db/
  :ex git clone git@github.com:musaubrian/stash @home/personal/stash --depth=1
  :ex ansible-vault decrypt @home/personal/db/*
  :b copy @home/personal/db/ @home/.db/
  :ex ansible-vault encrypt @home/personal/db/*
}

:wp dotfiles {
  :sym @home/personal/nixe/config/git/ @home/.config/git
  :sym @home/personal/nixe/config/jj/ @home/.config/jj
  :sym @home/personal/nixe/config/fish/ @home/.config/fish
  :sym @home/personal/nixe/config/nvim/ @home/.config/nvim
  :sym @home/personal/nixe/config/mako/ @home/.config/mako
  :sym @home/personal/nixe/config/niri/ @home/.config/niri
  :sym @home/personal/nixe/config/caddy/ @home/.config/caddy
  :sym @home/personal/nixe/config/kitty/ @home/.config/kitty
  :sym @home/personal/nixe/config/Waybar/ @home/.config/waybar
  :sym @home/personal/nixe/config/fuzzel/ @home/.config/fuzzel
  :sym @home/personal/nixe/config/walls/ @home/.local/share/walls
  :sym @home/personal/nixe/config/scripts/ @home/.local/bin/scripts
  :sym @home/personal/nixe/config/shell/.bashrc @home/.bashrc
  :sym @home/personal/nixe/config/shell/.aliases @home/.aliases
  :sym @home/personal/nixe/config/shell/.profile @home/.profile
}

:wp fonts {
  :b create @home/.fonts
  :ex wget https://github.com/ahatem/IoskeleyMono/releases/download/v2.1.0/IoskeleyMono-Term.zip -O ./IoskeleyMono-Term.zip
  :ex unzip -q -o IoskeleyMono-Term.zip -d IoskeleyMono-Term
// :b move ./IoskeleyMono-Term/ @home/.fonts/IoskeleyMono-Term/
// :ex fc-cache
}

:wp zen {
  :ex wget https://github.com/zen-browser/desktop/releases/latest/download/zen-x86_64.AppImage -O zen
  :ex chmod +x zen
  :b move ./zen @home/.local/bin/zen
  :b create @home/.local/share/applications/
  :b copy ./config/desktop/zen.desktop @home/.local/share/applications/zen.desktop
}

:wp update_git_repo {
  :ex git remote remove origin
  :ex git remote add origin git@github.com:musaubrian/nixe
}

:wp setup_php {
  :ex sudo pacman -Syu --noconfirm --needed php composer php-gd \
      php-sqlite php-sodium
}
